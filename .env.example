# HotPay — set these in Vercel Project Settings → Environment Variables.
# SEKRET and the notification password come from the HotPay panel
# (hotpay.pl) for your registered service. You must also paste the
# notification URL ({SITE_URL}/api/hotpay-webhook) into that same panel —
# HotPay does not accept it per-request like Przelewy24 did.
HOTPAY_SEKRET=
HOTPAY_PASSWORD=
SITE_URL=https://your-site.vercel.app

# InPost Geowidget — free public token from https://manager.paczkomaty.pl/
# → Moje konto → API → Geowidget. Served to the frontend via /api/config.
INPOST_GEOWIDGET_TOKEN=

# Upstash Redis — booking storage (double-booking prevention). Create a free
# database at https://console.upstash.com/ and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — booking confirmation emails. Create an API key at https://resend.com/
# and verify a sending domain, or use their onboarding@resend.dev for testing.
RESEND_API_KEY=
RESEND_FROM=Odnowina <rezerwacje@twojadomena.pl>
OWNER_EMAIL=hello@odnowina.pl

# Admin panel (/admin.html) — shared password sent as the x-admin-key header.
# Pick a long random value; this is the only thing protecting order/customer data.
ADMIN_PASSWORD=
